<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.squareetlabs</groupId>
  <artifactId>verifactu</artifactId>
  <packaging>jar</packaging>
  <version>1.1.0</version>
  <name>verifactu</name>
  <description>Java package for VeriFactu electronic invoicing management (AEAT)</description>
  <url>https://github.com/squareetlabs/verifactu-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/squareetlabs/verifactu-sdk/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Alberto Rial Barreiro</name>
      <organization>SquareetLabs</organization>
      <organizationUrl>https://www.squareet.com</organizationUrl>
    </developer>
    <developer>
      <name>Jacobo Cantorna Cigarran</name>
      <organization>SquareetLabs</organization>
      <organizationUrl>https://www.squareet.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/squareetlabs/verifactu-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/squareetlabs/verifactu-sdk.git</developerConnection>
    <url>https://github.com/squareetlabs/verifactu-sdk</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <cxf.version>3.5.7</cxf.version>
    <dss.version>5.11.1</dss.version>
  </properties>

  <dependencies>
    <!-- Apache CXF -->
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxws</artifactId>
      <version>${cxf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-transports-http</artifactId>
      <version>${cxf.version}</version>
    </dependency>
    
    <!-- JAXB Runtime -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.8</version>
    </dependency>
    <dependency>
      <groupId>javax.xml.ws</groupId>
      <artifactId>jaxws-api</artifactId>
      <version>2.3.1</version>
    </dependency>

    <!-- EU DSS for XAdES -->
    <dependency>
      <groupId>eu.europa.ec.joinup.sd-dss</groupId>
      <artifactId>dss-xades</artifactId>
      <version>${dss.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.europa.ec.joinup.sd-dss</groupId>
      <artifactId>dss-utils-apache-commons</artifactId>
      <version>${dss.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.europa.ec.joinup.sd-dss</groupId>
      <artifactId>dss-token</artifactId>
      <version>${dss.version}</version>
    </dependency>
    
    <!-- ZXing for QR Code Generation -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.3</version>
    </dependency>
    
    <!-- Testing -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-codegen-plugin</artifactId>
        <version>${cxf.version}</version>
        <executions>
          <execution>
            <id>generate-sources</id>
            <phase>generate-sources</phase>
            <configuration>
              <sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
              <wsdlOptions>
                <wsdlOption>
                  <!-- Using the pre-production WSDL as default/example -->
                  <wsdl>${project.basedir}/src/main/resources/SistemaFacturacion.wsdl</wsdl>
                  <extraargs>
                    <extraarg>-p</extraarg>
                    <extraarg>com.squareetlabs.verifactu.aeat</extraarg>
                    <extraarg>-autoNameResolution</extraarg>
                  </extraargs>
                </wsdlOption>
              </wsdlOptions>
            </configuration>
            <goals>
              <goal>wsdl2java</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      
      <!-- Source Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.2.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      
      <!-- Javadoc Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <doclint>none</doclint>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    Perfil "release": firma GPG y publicacion en Maven Central.
    No se activa por defecto, para no exigir claves GPG a quien solo compila
    o ejecuta tests en local. Se invoca explicitamente en CI con "-P release".
    Requiere:
      - Un servidor "central" en settings.xml (usuario/token del Central
        Publisher Portal, https://central.sonatype.com), generado por
        actions/setup-java a partir de los secretos CENTRAL_USERNAME y
        CENTRAL_PASSWORD.
      - Una clave GPG importada por actions/setup-java (secreto
        GPG_PRIVATE_KEY) y su passphrase en la variable de entorno
        GPG_PASSPHRASE (secreto GPG_PASSPHRASE).
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Firma GPG de todos los artefactos (jar, sources, javadoc, pom) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!-- Empaqueta y publica en el Central Publisher Portal -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                Manual la primera vez: tras "mvn deploy" hay que entrar en
                https://central.sonatype.com/publishing/deployments y pulsar
                "Publish" cuando la validacion termine en OK. Una vez
                comprobado que el pipeline funciona, se puede poner en true
                para que el release quede totalmente automatizado.
              -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
